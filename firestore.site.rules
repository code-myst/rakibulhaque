rules_version = '2';

// ============================================================
//  CODEMYST Portfolio Site — Firestore Security Rules
//  Project: rakibul-haque  (আলাদা Firebase project!)
//
//  ⚠️ সেটআপ: নিচের ADMIN_EMAILS-এ আপনার Google ইমেইল বসিয়ে Publish করুন।
//  তারপর অ্যাডমিন প্যানেল → জেনারেল → সাইট কনটেন্ট-এ লগইন করলেই
//  আপনার অ্যাকাউন্ট অটো-admin হয়ে যাবে (কনসোলে ডক এডিট লাগবে না)।
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ⬇️⬇️ এখানে আপনার Google ইমেইল বসান (কমা দিয়ে একাধিকও দেওয়া যায়)
    function adminEmails() {
      return ['YOUR-GOOGLE-EMAIL@gmail.com'];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAllowlistedAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email in adminEmails();
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && (myRole() == 'admin' || isAllowlistedAdmin());
    }

    // ------------------------------------------------------------ site content
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------ users (site project)
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // self-create: visitor সবাই; admin শুধু allowlist-এ থাকা ইমেইল
      allow create: if request.auth != null && request.auth.uid == uid
                    && (request.resource.data.role == 'visitor'
                        || (request.resource.data.role == 'admin'
                            && request.auth.token.email in adminEmails()))
                    || isAdmin();
      allow update: if isAdmin()
                    || (request.auth != null && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['name', 'email', 'phone']))
                    || (request.auth != null && request.auth.uid == uid
                    && resource.data.role == 'visitor'
                    && request.resource.data.role == 'client'
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['role', 'phone']))
                    // allowlist-এ থাকলে visitor → admin আপগ্রেডও অটো
                    || (request.auth != null && request.auth.uid == uid
                    && isAllowlistedAdmin()
                    && request.resource.data.role == 'admin');
      allow delete: if isAdmin();

      // ক্লায়েন্টের অর্ডার স্ন্যাপশট (প্রোফাইল হিস্টোরি)
      match /orders/{orderId} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
        // ক্লায়েন্ট অর্ডারের সময় নিজের স্ন্যাপশট তৈরি করে; status sync শুধু অ্যাডমিন
        allow create: if request.auth != null && (request.auth.uid == uid || isAdmin())
                      && request.resource.data.status == 'pending';
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ------------------------------------------------------------ blog
    match /blog/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------ contact messages
    match /messages/{msgId} {
      function validIncoming() {
        return request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.email is string
          && request.resource.data.email.matches('.*@.*\..*')
          && request.resource.data.thread.size() == 1
          && request.resource.data.thread[0].from == 'visitor'
          && request.resource.data.thread[0].text is string
          && request.resource.data.thread[0].text.size() > 0
          && request.resource.data.status == 'new'
          && (request.resource.data.visitorUid == null
              || request.resource.data.visitorUid == request.auth.uid);
      }

      allow create: if validIncoming();
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.visitorUid == request.auth.uid);
      allow update: if isAdmin()
                    || (isSignedIn() && resource.data.visitorUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------ recommendations
    match /recommendations/{recId} {
      function validSubmission() {
        return request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() < 60
          && request.resource.data.text is string
          && request.resource.data.text.size() > 4
          && request.resource.data.text.size() < 600
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.status == 'pending'
          && request.resource.data.uid is string;
      }

      // শুধু লগইন করা ক্লায়েন্ট (নিজের uid) রেকমেন্ডেশন দিতে পারে
      allow create: if validSubmission() && request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && (myRole() == 'client' || isAdmin());

      allow read: if resource.data.status == 'approved'
                  || (request.auth != null && resource.data.uid == request.auth.uid)
                  || isAdmin();

      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status']);
      allow delete: if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
